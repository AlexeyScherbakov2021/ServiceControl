<Window x:Class="ServiceControl.View.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ServiceControl.View"
        mc:Ignorable="d"
        Title="{DynamicResource About}" Height="330" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid>
        <Image Source="/Resources/wp.png" Stretch="Fill"/>
        <TextBlock HorizontalAlignment="Left" Margin="210,137,0,0" TextWrapping="Wrap" Text="Service Control" 
                   VerticalAlignment="Top" FontSize="22" Foreground="White"/>
        <TextBlock x:Name="MajorVersion" HorizontalAlignment="Left" Margin="220,159,0,0"  Text="1.1" 
                   FontSize="48" FontWeight="Bold" Foreground="LightGreen"/>
        <TextBlock HorizontalAlignment="Left" Margin="135,225,0,0" Style="{x:Null}" 
                 VerticalAlignment="Top" Width="263" FontSize="10" Foreground="White">
            <Run Text="Service program device NGK"/>
            <LineBreak/>
            <Run x:Name="NameVersion" Text="Version 1.1"/>
            <LineBreak/>
            <Run Text="Copyright © 2025 "/>
            <LineBreak/>
            <Run Text="All right reserved."/>
        </TextBlock>
    </Grid>
</Window>
