<UserControl x:Class="ServiceControl.View.BIT_UCView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ServiceControl.View"
             xmlns:vm="clr-namespace:ServiceControl.ViewModel"
             mc:Ignorable="d" 
             x:Name="mainControl" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <vm:BIT_UCViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Border  Margin="14" Grid.Row="0" Grid.Column="0" Height="210" Width="500" VerticalAlignment="Top">
            <GroupBox Margin="0,0,0,-35" >
                <GroupBox.Header>
                    <TextBlock Text="Установки кстройства" FontSize="16" FontWeight="Bold"/>
                </GroupBox.Header>
                <StackPanel Margin="8" Orientation="Vertical">

                    <!--Регистры управления-->
                    <ItemsControl ItemsSource="{Binding ListInput}" >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Width="170" 
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Value, StringFormat=0.00, TargetNullValue=--}" Width="80" VerticalAlignment="Top"
                                        Margin="4,0" Padding="2,1" FontWeight="Bold" ToolTip="{Binding ToolTip}" IsReadOnly="True"
                                        TextAlignment="Right" Background="White" />
                                    <TextBlock Text="{Binding Measure}" VerticalAlignment="Top" 
                                               TextAlignment="Left" Width="20" Margin="2,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding ListWriteControl}" Margin="0,2,0,0" >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Register1.Name}" TextWrapping="Wrap" Width="170" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Register1.Value, StringFormat=0.###, TargetNullValue=--}" Width="80"
                                        Margin="4,0" ToolTip="{Binding Register2.ToolTip}" IsReadOnly="False"/>
                                    <TextBlock Text="{Binding Register1.Measure}" VerticalAlignment="Center" Width="20" 
                                               TextAlignment="Left" Margin="2,2,4,0"/>
                                    <TextBlock Text="{Binding Register2.Description}" VerticalAlignment="Center" Width="20" Margin="2,2,4,0"/>

                                    <!--<TextBox Text="{Binding Register2.Value, StringFormat=0.###, TargetNullValue=-}" Width="64" 
                                        Margin="4,0" ToolTip="{Binding Register2.ToolTip}" Style="{DynamicResource TextBox.Control}" 
                                             TabIndex="2">
                                        <TextBox.InputBindings>
                                            <KeyBinding Gesture="Enter" 
                                                        CommandParameter="{Binding Register2}"
                                                        Command="{Binding DataContext.WriteValueCommand, ElementName=mainControl}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>-->


                                    <Button Width="30" Margin="1" VerticalAlignment="Top" ToolTip="{DynamicResource Set}" Style="{StaticResource ButtonStyle1}"
                                            CommandParameter="{Binding}" Padding="3"
                                            Command="{Binding DataContext.WriteValueCommand, ElementName=mainControl}">
                                        <!--<fa:ImageAwesome Icon="Solid_SignOutAlt" Height="14" Style="{StaticResource faStyle}">
                                        </fa:ImageAwesome>-->
                                        <Image Source="/Resources/Logout.png" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>


                    <!--<StackPanel Orientation="Horizontal">
                        <TextBlock Text="Радиус трубы" TextWrapping="Wrap" Width="250" 
                                               TextAlignment="Right" VerticalAlignment="Top"/>
                        <TextBox Text="{Binding Radius}" Width="164" VerticalAlignment="Top"
                                        Margin="4,0" Padding="2,1" FontWeight="Bold" ToolTip="{Binding Register1.ToolTip}" IsReadOnly="True"
                                        TextAlignment="Right" Background="White" />
                        <TextBlock Text="мм." VerticalAlignment="Top" Width="20" Margin="2,2,0,0"/>
                    </StackPanel>-->

                    <!--<StackPanel Orientation="Horizontal">
                        <TextBlock Text="Поправочный коэффициент" TextWrapping="Wrap" Width="250" 
                                               TextAlignment="Right" VerticalAlignment="Top"/>
                        <TextBox Text="{Binding CorrKoeff}" Width="164" VerticalAlignment="Top"
                                        Margin="4,0" Padding="2,1" FontWeight="Bold" ToolTip="{Binding Register1.ToolTip}" IsReadOnly="True"
                                        TextAlignment="Right" Background="White" />
                        -->
                    <!--<TextBlock Text="" VerticalAlignment="Top" Width="20" Margin="2,2,0,0"/>-->
                    <!--
                    </StackPanel>
                    <Button Content="Отправить Gauss" Command="{Binding GaussCommand}"/>-->
                    <Button Content="Сброс" Command="{Binding ResetCommand}" Margin="0,20" Width="60" Height="19"/>

                </StackPanel>
            </GroupBox>
        </Border>

    </Grid>
</UserControl>
